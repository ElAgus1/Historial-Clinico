# Supabase / PostgreSQL
# Get both connection strings from Supabase: Project Settings > Database > Connection string.
# Use the transaction pooler string for serverless/runtime database access.
# Replace PROJECT_PASSWORD and POOLER_HOST with values from your Supabase project.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PROJECT_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Use the direct connection string for Prisma generate/db push/migrations.
# Replace PROJECT_PASSWORD and DB_HOST with values from your Supabase project.
DIRECT_URL="postgresql://postgres:PROJECT_PASSWORD@DB_HOST:5432/postgres"

# Supabase public project URL.
# Find it in Supabase: Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Supabase publishable/anonymous key for browser and server authentication.
# Find it in Supabase: Project Settings > API > Publishable and anon keys.
# Never expose a service-role key as a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-supabase-anon-key"
