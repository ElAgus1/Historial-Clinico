// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Paciente {
  id              String     @id @default(uuid())
  userId          String?
  nombreCompleto  String
  fechaNacimiento DateTime?
  lugarNacimiento String?
  lugarResidencia String?
  profesion       String?
  religion        String?
  telefono        String?
  motivoConsulta  String?    @db.Text
  nombrePadre     String?
  nombreMadre     String?
  estadoCivil     String?
  sexo            String?
  archivado       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  sesiones        Sesion[]
  citas           Cita[]
  anamnesis       Anamnesis?

  @@index([nombreCompleto])
  @@index([createdAt])
  @@index([userId])
  @@index([userId, archivado])
}

model Anamnesis {
  id                     String   @id @default(uuid())
  pacienteId             String   @unique
  antecedentesPropios    String?  @db.Text
  antecedentesFamiliares String?  @db.Text
  genogramaPath          String?
  historiaVital          Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  paciente               Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
}

model Sesion {
  id            String   @id @default(uuid())
  pacienteId    String
  fechaSesion   DateTime @default(now())
  notasClinicas String
  createdAt     DateTime @default(now())
  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
  @@index([fechaSesion])
}

model Cita {
  id         String   @id @default(uuid())
  pacienteId String
  fechaCita  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
  @@index([fechaCita])
}
